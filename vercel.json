{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "links.html",
      "use": "@vercel/static"
    },
    {
      "src": "media.html",
      "use": "@vercel/static"
    },
    {
      "src": "portal/add-media.html",
      "use": "@vercel/static"
    },
    {
      "src": "script.js",
      "use": "@vercel/static"
    },
    {
      "src": "media.js",
      "use": "@vercel/static"
    },
    {
      "src": "media-admin.js",
      "use": "@vercel/static"
    },
    {
      "src": "links-shows.js",
      "use": "@vercel/static"
    },
    {
      "src": "styles.css",
      "use": "@vercel/static"
    },
    {
      "src": "hero-desktop.jpg",
      "use": "@vercel/static"
    },
    {
      "src": "hero-performance.jpg",
      "use": "@vercel/static"
    },
    {
      "src": "hero-mobile.jpg",
      "use": "@vercel/static"
    },
    {
      "src": "about-photo.jpg",
      "use": "@vercel/static"
    },
    {
      "src": "logos/**",
      "use": "@vercel/static"
    },
    {
      "src": "titty-monster-thumbnail.png",
      "use": "@vercel/static"
    },
    {
      "src": "hero-backstage.png",
      "use": "@vercel/static"
    },
    {
      "src": "og-image.jpg",
      "use": "@vercel/static"
    },
    {
      "src": "favicon.svg",
      "use": "@vercel/static"
    },
    {
      "src": "apple-touch-icon.png",
      "use": "@vercel/static"
    },
    {
      "src": "drillmaster-card.png",
      "use": "@vercel/static"
    },
    {
      "src": "data/media.json",
      "use": "@vercel/static"
    },
    {
      "src": "data/press-grid.json",
      "use": "@vercel/static"
    },
    {
      "src": "images/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/shows",
      "dest": "api/shows.js"
    },
    {
      "src": "/api/add-show",
      "dest": "api/add-show.js"
    },
    {
      "src": "/api/delete-show",
      "dest": "api/delete-show.js"
    },
    {
      "src": "/api/send-booking",
      "dest": "api/send-booking.js"
    },
    {
      "src": "/api/media",
      "dest": "api/media.js"
    },
    {
      "src": "/api/fetch-media",
      "dest": "api/fetch-media.js"
    },
    {
      "src": "/api/add-media",
      "dest": "api/add-media.js"
    },
    {
      "src": "/api/unfurl",
      "dest": "api/unfurl.js"
    },
    {
      "src": "/links",
      "dest": "/links.html"
    },
    {
      "src": "/media",
      "dest": "/media.html"
    },
    {
      "src": "/portal/add-media",
      "dest": "/portal/add-media.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
